{
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    { "type": "ColumnSet", "columns": [
      { "type": "Column", "width": 1, "items": [
        { "type": "Input.Text", "label": "Name", "style": "text", "id": "SimpleVal", "isRequired": true, "errorMessage": "Name is required", "placeholder": "Enter your name" },
        { "type": "Input.Number", "label": "Quantity", "min": -5, "max": 5, "value": 1, "id": "NumVal" }
      ] },
      { "type": "Column", "width": 1, "items": [
        { "type": "Input.ChoiceSet", "id": "MultiSelectVal", "label": "Colors", "isMultiSelect": true, "value": "1,3", "choices": [
          { "title": "Red", "value": "1" }, { "title": "Green", "value": "2" }, { "title": "Blue", "value": "3" }
        ] },
        { "type": "Input.Toggle", "label": "Terms", "title": "Accept terms", "valueOn": "true", "valueOff": "false", "value": "true", "id": "AcceptsTerms", "isRequired": true }
      ] }
    ] }
  ]
}
