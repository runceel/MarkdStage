{
  "name": "markdstage-tests",
  "private": true,
  "type": "module",
  "description": "Test and CI infrastructure for the MarkdStage canvas Extension (not included in distributions)",
  "scripts": {
    "test": "npm run test:ci && npm run test:docs && npm run test:site && npm run test:vendor && npm run test:schema && npm run test:unit && npm run test:cli && npm run test:editing && npm run test:visual && npm run test:a11y && npm run test:perf && npm run test:pdf && npm run test:pptx",
    "build:site": "node scripts/build-site.mjs",
    "preview:site": "npm run build:site && node scripts/serve-site.mjs",
    "test:site": "node --test test/site/*.test.mjs && playwright test --project=site",
    "test:ci": "node --test test/ci/*.test.mjs",
    "test:samples": "node scripts/ci-samples.mjs",
    "test:docs": "node scripts/check-markdown-links.mjs",
    "test:vendor": "cd .github/extensions/markdstage && node scripts/vendor-assets.mjs verify vendor vendor/vendor-assets.lock.json",
    "generate:architecture": "node .github/extensions/markdstage/scripts/generate-architecture-contract.mjs",
    "check:architecture": "node .github/extensions/markdstage/scripts/generate-architecture-contract.mjs --check",
    "test:schema": "npm run check:architecture && node --test test/schema/*.test.mjs",
    "test:unit": "cd .github/extensions/markdstage && node --test",
    "test:cli": "cd packages/markdstage-cli && npm test",
    "skills": "cd packages/markdstage-cli && npm run skills",
    "skills:check": "cd packages/markdstage-cli && npm run skills:check",
    "test:visual": "playwright test --project=visual",
    "test:editing": "playwright test --project=editing",
    "test:pdf": "playwright test --project=pdf",
    "test:pptx": "playwright test --project=pptx",
    "test:a11y": "playwright test --project=a11y",
    "test:perf": "playwright test --project=perf",
    "test:visual:update": "playwright test --project=visual --update-snapshots",
    "test:docker": "node test/scripts/playwright-docker.mjs",
    "test:visual:update:linux": "node test/scripts/playwright-docker.mjs --project=visual --update-snapshots"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "ajv": "8.20.0",
    "axe-core": "4.13.0"
  }
}
