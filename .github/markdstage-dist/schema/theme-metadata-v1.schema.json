{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/runceel/markdstage/schema/theme-metadata-v1.schema.json",
  "title": "Presentation custom theme metadata v1",
  "description": "Optional theme.json manifest stored beside a custom theme CSS file.",
  "type": "object",
  "required": ["version"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "background": {
      "description": "Common decorative background for default and center layouts only.",
      "$ref": "#/$defs/decorativeImage"
    },
    "layouts": {
      "type": "object",
      "properties": {
        "default": {
          "$ref": "#/$defs/layoutBackground"
        },
        "center": {
          "$ref": "#/$defs/layoutBackground"
        }
      },
      "additionalProperties": false
    },
    "cover": {
      "type": "object",
      "properties": {
        "background": {
          "$ref": "#/$defs/decorativeImage"
        },
        "logo": {
          "$ref": "#/$defs/meaningfulImage"
        }
      },
      "additionalProperties": false
    },
    "backcover": {
      "type": "object",
      "properties": {
        "logo": {
          "$ref": "#/$defs/meaningfulImage"
        },
        "copyright": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "layoutBackground": {
      "type": "object",
      "properties": {
        "background": {
          "$ref": "#/$defs/decorativeImage"
        }
      },
      "additionalProperties": false
    },
    "assetPath": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^assets/(?:[A-Za-z0-9][A-Za-z0-9_-]*(?:\\.[A-Za-z0-9_-]+)*/)*[A-Za-z0-9][A-Za-z0-9_-]*(?:\\.[A-Za-z0-9_-]+)*\\.(?:svg|png|webp|jpg|jpeg)$"
    },
    "decorativeImage": {
      "type": "object",
      "required": ["image"],
      "properties": {
        "image": {
          "$ref": "#/$defs/assetPath"
        },
        "alt": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "meaningfulImage": {
      "type": "object",
      "required": ["image", "alt"],
      "properties": {
        "image": {
          "$ref": "#/$defs/assetPath"
        },
        "alt": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
