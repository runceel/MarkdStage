{
  "name": "MarkdStage",
  "tagline": "Markdown slide authoring and presentation",
  "repository": "https://github.com/runceel/markdstage",
  "storeUrl": "https://apps.microsoft.com/detail/9N9DG772RM03",
  "releaseTag": "v4.2.5",
  "cliSetupCommand": "npm install --global @markdstage/markdstage",
  "cliSkillCommand": "markdstage skill install --target claude",
  "cliAlternativeCommand": "markdstage skill install --target codex",
  "cliPreviewCommand": "markdstage preview slides.md --watch",
  "cliCheckCommand": "markdstage validate slides.md --json\nmarkdstage inspect slides.md --json",
  "cliCommand": "markdstage present slides.md",
  "cliExportCommand": "markdstage export slides.md --output slides.pdf\nmarkdstage export slides.md --output slides.pptx",
  "macUrl": "https://github.com/07JP27/MarkStageForMac"
}
