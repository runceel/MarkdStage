<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MarkdStage.Core.Tests</RootNamespace>
    <AssemblyName>MarkdStage.Core.Tests</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Compile Include="..\..\src\MarkdStage.Cli\CliArguments.cs" Link="Cli\CliArguments.cs" />
    <Compile Include="..\..\src\MarkdStage.Cli\HostCommands.cs" Link="Cli\HostCommands.cs" />
    <Compile Include="..\..\src\MarkdStage.Cli\BrowserProcess.cs" Link="Cli\BrowserProcess.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MarkdStage.Core\MarkdStage.Core.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Compile Include="..\..\src\MarkdStage.App\Services\DeckLoadException.cs" Link="Services\DeckLoadException.cs" />
    <Compile Include="..\..\src\MarkdStage.App\Services\DeckAssetResolver.cs" Link="Services\DeckAssetResolver.cs" />
    <Compile Include="..\..\src\MarkdStage.App\Services\SlideBackgrounds.cs" Link="Services\SlideBackgrounds.cs" />
    <Compile Include="..\..\src\MarkdStage.App\Services\PathSecurity.cs" Link="Services\PathSecurity.cs" />
    <Compile Include="..\..\src\MarkdStage.App\Services\ThemeService.cs" Link="Services\ThemeService.cs" />
    <Compile Include="..\..\src\MarkdStage.App\Services\PresentationServer.cs" Link="Services\PresentationServer.cs" />
    <Compile Include="..\..\src\MarkdStage.App\Services\VendorAssetProvider.cs" Link="Services\VendorAssetProvider.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\..\..\.github\extensions\markdstage\renderer\index.html">
      <Link>Web\index.html</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\..\..\.github\extensions\markdstage\vendor\mermaid.min.js.part-*;..\..\..\..\.github\extensions\markdstage\vendor\vendor-assets.lock.json">
      <Link>Web\vendor\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\..\..\test\fixtures\markdown-deck-corpus.json">
      <Link>Fixtures\markdown-deck-corpus.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>