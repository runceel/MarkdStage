<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="MarkdStageApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MarkdStageApp"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MarkdStage"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <!-- Only fires while focus is in the XAML tree; the stage WebView forwards its own Escape. -->
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeAccelerator" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Background="{ThemeResource BrandTitleBarBackgroundBrush}"
            Foreground="{ThemeResource BrandTitleBarForegroundBrush}"
            Subtitle="Markdown, ready for the stage."
            Title="MarkdStage">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
            <TitleBar.LeftHeader>
                <!--
                    The start screen doubles as the workspace file list, so a deck needs a way
                    back to it. There is deliberately no reverse route: the deck is one click
                    away in the list itself.
                -->
                <Button
                    x:Name="BackToFilesButton"
                    Width="36"
                    Height="32"
                    Margin="4,0,4,0"
                    Padding="0"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="BackToFilesButton"
                    AutomationProperties.Name="Back to the file list"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnBackToFilesClick"
                    ToolTipService.ToolTip="Back to the file list (Esc)"
                    Visibility="Collapsed">
                    <FontIcon FontSize="14" Glyph="&#xE72B;" />
                </Button>
            </TitleBar.LeftHeader>
        </TitleBar>

        <!--
            The Frame hosts pages for your application content. Add your UI to
            MainPage.xaml rather than here so you can use Page features such as
            navigation events and the Loaded lifecycle.
        -->
        <Frame x:Name="RootFrame" Grid.Row="1" />
    </Grid>
</Window>
