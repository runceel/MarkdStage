<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>MarkdStageApp</RootNamespace>
    <AssemblyName>MarkdStageApp</AssemblyName>
    <Product>MarkdStage</Product>
    <Description>Markdown, ready for the stage.</Description>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>false</EnableMsixTooling>
    <EnableWinAppRunSupport>false</EnableWinAppRunSupport>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <AppxPackage>false</AppxPackage>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\*.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\AppIcon.ico" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
    <None Update="Assets\AppIcon.svg">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
    <Content Include="Package.appxmanifest">
      <Link>appxmanifest.xml</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <RepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\..\..'))</RepositoryRoot>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="$(RepositoryRoot)\.github\extensions\markdstage\renderer\index.html">
      <Link>Web\index.html</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="$(RepositoryRoot)\.github\extensions\markdstage\renderer\**\*"
             Exclude="$(RepositoryRoot)\.github\extensions\markdstage\renderer\index.html">
      <Link>Web\renderer\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="$(RepositoryRoot)\.github\extensions\markdstage\architecture-editor\**\*">
      <Link>Web\architecture-editor\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="$(RepositoryRoot)\.github\extensions\markdstage\vendor\**\*">
      <Link>Web\vendor\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="$(RepositoryRoot)\assets\brand\markdstage-mark.svg">
      <Link>Assets\Brand\markdstage-mark.svg</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="$(RepositoryRoot)\.github\extensions\markdstage\THIRD-PARTY-NOTICES.md">
      <Link>THIRD-PARTY-NOTICES.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="$(RepositoryRoot)\.github\extensions\markdstage\windows\pen-button-listener.ps1">
      <Link>SurfacePen\pen-button-listener.ps1</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <!--
    Microsoft.Windows.SDK.BuildTools.WinApp adds first-class support for
    `dotnet run` on packaged WinUI apps: it hooks the .NET CLI Run target to
    register a debug identity via the winapp CLI and launch the app with
    package identity (AUMID).
    Set <EnableWinAppRunSupport>false</EnableWinAppRunSupport> in a
    <PropertyGroup> above to opt out.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.6.1" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MarkdStage.Core\MarkdStage.Core.csproj" />
    <Compile Include="..\MarkdStage.Cli\BrowserAutomation.cs" Link="NativeOutput\BrowserAutomation.cs" />
    <Compile Include="..\MarkdStage.Cli\BrowserProcess.cs" Link="NativeOutput\BrowserProcess.cs" />
    <Compile Include="..\MarkdStage.Cli\CdpConnection.cs" Link="NativeOutput\CdpConnection.cs" />
    <Compile Include="..\MarkdStage.Cli\CliArguments.cs" Link="NativeOutput\CliArguments.cs" />
    <Compile Include="..\MarkdStage.Cli\NativeBrowserHost.cs" Link="NativeOutput\NativeBrowserHost.cs" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun>False</PublishReadyToRun>
    <PublishTrimmed>False</PublishTrimmed>
  </PropertyGroup>

  <Target Name="CopyWinUIResourcesToPublish"
          AfterTargets="Publish"
          Condition="'$(WindowsPackageType)' != 'MSIX'">
    <ItemGroup>
      <_WinUIXbf Include="$(TargetDir)**\*.xbf" />
      <_WinUIPri Include="$(TargetDir)*.pri" />
      <_WinUIAsset Include="$(TargetDir)Assets\**\*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(_WinUIXbf)"
      DestinationFiles="@(_WinUIXbf->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
    <Copy
      SourceFiles="@(_WinUIPri)"
      DestinationFolder="$(PublishDir)"
      SkipUnchangedFiles="true" />
    <Copy
      SourceFiles="@(_WinUIAsset)"
      DestinationFiles="@(_WinUIAsset->'$(PublishDir)Assets\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyNativeCliToAppOutput" AfterTargets="Build">
    <Exec Command="dotnet build &quot;$(MSBuildThisFileDirectory)..\MarkdStage.Cli\MarkdStage.Cli.csproj&quot; --configuration &quot;$(Configuration)&quot; --runtime &quot;$(RuntimeIdentifier)&quot; --property:Platform=&quot;$(Platform)&quot; --property:SelfContained=&quot;$(SelfContained)&quot; --property:WindowsAppSDKSelfContained=&quot;$(WindowsAppSDKSelfContained)&quot;" />
    <MSBuild Projects="..\MarkdStage.Cli\MarkdStage.Cli.csproj"
             Targets="GetNativeLauncherFiles"
             Properties="Configuration=$(Configuration);Platform=$(Platform);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);WindowsAppSDKSelfContained=$(WindowsAppSDKSelfContained)">
      <Output TaskParameter="TargetOutputs" ItemName="_NativeCliFiles" />
    </MSBuild>
    <Copy SourceFiles="@(_NativeCliFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyNativeCliToAppPublish"
          AfterTargets="Publish"
          DependsOnTargets="CopyNativeCliToAppOutput"
          Condition="'$(WindowsPackageType)' != 'MSIX'">
    <Copy SourceFiles="@(_NativeCliFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="AddNativeCliToMsixPayload"
          BeforeTargets="_ComputeAppxPackagePayload"
          DependsOnTargets="CopyNativeCliToAppOutput"
          Condition="'$(WindowsPackageType)' == 'MSIX'">
    <ItemGroup>
      <_NativePackageAssetFiles Include="$(NativePackageAssetsDirectory)\**\*" />
      <AppxPackagePayload Include="@(_NativeCliFiles)">
        <TargetPath>%(Filename)%(Extension)</TargetPath>
      </AppxPackagePayload>
      <AppxPackagePayload Include="@(_NativePackageAssetFiles)">
        <TargetPath>%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
      </AppxPackagePayload>
    </ItemGroup>
  </Target>
  <Import Project="..\MarkdStage.Cli\PackageAssets.targets" />
</Project>
