<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="MarkdStageApp.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MarkdStageApp"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!--
                    Must stay last. Merged dictionaries are probed in reverse order, so this is
                    the only placement where the brand accent actually replaces the Fluent one.
                -->
                <ResourceDictionary Source="ms-appx:///Themes/Brand.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>