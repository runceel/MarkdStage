<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MarkdStageApp.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    AllowDrop="True"
    DragOver="OnDragOver"
    Drop="OnDrop"
    mc:Ignorable="d">

    <Grid>
        <WebView2
            x:Name="StageWebView"
            AutomationProperties.AutomationId="StageWebView" />

        <InfoBar
            x:Name="PresentationErrorInfoBar"
            Margin="24"
            VerticalAlignment="Top"
            AutomationProperties.AutomationId="PresentationErrorInfoBar"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.IsErrorOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error"
            Title="Couldn't update the display" />

        <Border
            x:Name="WorkspaceStartScreen"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <StackPanel
                MaxWidth="760"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Spacing="16">
                <TextBlock
                    x:Name="WorkspaceHeading"
                    Text="Open a workspace"
                    Style="{StaticResource TitleTextBlockStyle}"
                    TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="Open folder…" Click="OnOpenFolderClick" />
                    <Button
                        AutomationProperties.AutomationId="OpenMarkdownButton"
                        Content="Open Markdown file…"
                        Command="{x:Bind ViewModel.OpenMarkdownCommand}" />
                    <Button
                        x:Name="RefreshWorkspaceButton"
                        Content="Refresh"
                        Click="OnRefreshWorkspaceClick"
                        Visibility="Collapsed" />
                </StackPanel>
                <ListView
                    x:Name="WorkspaceItems"
                    MaxHeight="500"
                    IsItemClickEnabled="True"
                    ItemClick="OnWorkspaceItemClick"
                    SelectionMode="None" />
            </StackPanel>
        </Border>

        <WebView2
            x:Name="RuntimeWebView"
            Width="1"
            Height="1"
            Opacity="0"
            IsHitTestVisible="False"
            IsTabStop="False" />

        <Border
            x:Name="RuntimeMissingScreen"
            Visibility="Collapsed"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <StackPanel
                MaxWidth="620"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="20">
                <TextBlock
                    Text="MarkdStage can't start"
                    Style="{StaticResource TitleTextBlockStyle}"
                    IsTextSelectionEnabled="True" />
                <TextBlock
                    Text="MarkdStage needs the Microsoft Edge WebView2 Runtime, which isn't installed on this PC. Most Windows PCs already have it; on this one it's missing or its data folder isn't accessible."
                    IsTextSelectionEnabled="True"
                    TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <HyperlinkButton
                        Content="Get the runtime"
                        NavigateUri="https://developer.microsoft.com/microsoft-edge/webview2/" />
                    <Button Content="Try again" Click="OnRetryRuntimeClick" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
