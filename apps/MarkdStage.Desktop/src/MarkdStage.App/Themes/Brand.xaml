<?xml version="1.0" encoding="utf-8"?>
<!--
    Merged after XamlControlsResources on purpose. Merged dictionaries are probed in
    reverse order, so this is the only placement where the accent overrides below
    actually beat the Fluent defaults that XamlControlsResources brings in.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <!--
            MarkdStage always wears its own ink palette so the slide preview stays the
            brightest thing on screen. "Default" covers both the Light and Dark system
            themes on purpose; only high contrast defers to the system.
        -->
        <ResourceDictionary x:Key="Default">
            <Color x:Key="BrandInkDeepColor">#0B1020</Color>
            <Color x:Key="BrandInkColor">#151B2F</Color>
            <Color x:Key="BrandInkElevatedColor">#1B2340</Color>
            <Color x:Key="BrandStrokeColor">#29314C</Color>
            <Color x:Key="BrandPaperColor">#F7F4ED</Color>
            <Color x:Key="BrandMutedColor">#C8CEDD</Color>
            <Color x:Key="BrandAccentColor">#FFB547</Color>
            <Color x:Key="BrandAccentLightColor">#FFD77A</Color>

            <SolidColorBrush x:Key="BrandInkDeepBrush" Color="#0B1020" />
            <SolidColorBrush x:Key="BrandInkBrush" Color="#151B2F" />
            <SolidColorBrush x:Key="BrandInkElevatedBrush" Color="#1B2340" />
            <SolidColorBrush x:Key="BrandStrokeBrush" Color="#29314C" />
            <SolidColorBrush x:Key="BrandPaperBrush" Color="#F7F4ED" />
            <SolidColorBrush x:Key="BrandMutedBrush" Color="#C8CEDD" />
            <SolidColorBrush x:Key="BrandAccentBrush" Color="#FFB547" />
            <SolidColorBrush x:Key="BrandAccentLightBrush" Color="#FFD77A" />
            <SolidColorBrush x:Key="BrandOnAccentBrush" Color="#0B1020" />
            <SolidColorBrush x:Key="BrandTitleBarBackgroundBrush" Color="#151B2F" />
            <SolidColorBrush x:Key="BrandTitleBarForegroundBrush" Color="#F7F4ED" />
            <SolidColorBrush x:Key="BrandOverlayBrush" Color="#0B1020" Opacity="0.72" />

            <LinearGradientBrush x:Key="BrandStageBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#151B2F" />
                <GradientStop Offset="1" Color="#0B1020" />
            </LinearGradientBrush>
            <RadialGradientBrush
                x:Key="BrandSpotlightBrush"
                Center="0.5,0.16"
                GradientOrigin="0.5,0.16"
                RadiusX="0.78"
                RadiusY="0.92">
                <GradientStop Offset="0" Color="#33FFD77A" />
                <GradientStop Offset="0.55" Color="#12FFB547" />
                <GradientStop Offset="1" Color="#00FFB547" />
            </RadialGradientBrush>

            <!-- Accent-driven Fluent controls pick up the stage amber. -->
            <Color x:Key="SystemAccentColor">#FFB547</Color>
            <Color x:Key="SystemAccentColorLight1">#FFC366</Color>
            <Color x:Key="SystemAccentColorLight2">#FFD188</Color>
            <Color x:Key="SystemAccentColorLight3">#FFE0AA</Color>
            <Color x:Key="SystemAccentColorDark1">#F0A93C</Color>
            <Color x:Key="SystemAccentColorDark2">#D9982F</Color>
            <Color x:Key="SystemAccentColorDark3">#B77D22</Color>

            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FFB547" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#F0A93C" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#D9982F" />
            <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#2A3350" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#0B1020" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#2A3350" />
            <SolidColorBrush x:Key="TextOnAccentFillColorDisabledBrush" Color="#7C86A3" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FFD77A" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#FFD77A" />
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#FFB547" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush
                x:Key="BrandInkDeepBrush"
                Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush
                x:Key="BrandInkBrush"
                Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush
                x:Key="BrandInkElevatedBrush"
                Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush
                x:Key="BrandStrokeBrush"
                Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush
                x:Key="BrandPaperBrush"
                Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush
                x:Key="BrandMutedBrush"
                Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush
                x:Key="BrandAccentBrush"
                Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush
                x:Key="BrandAccentLightBrush"
                Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush
                x:Key="BrandOnAccentBrush"
                Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush
                x:Key="BrandTitleBarBackgroundBrush"
                Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush
                x:Key="BrandTitleBarForegroundBrush"
                Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush
                x:Key="BrandOverlayBrush"
                Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush
                x:Key="BrandStageBrush"
                Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="BrandSpotlightBrush" Color="Transparent" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <CornerRadius x:Key="BrandCardCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="BrandPillCornerRadius">999</CornerRadius>

    <Style x:Key="BrandCardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource BrandInkBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BrandStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource BrandCardCornerRadius}" />
    </Style>

    <Style x:Key="BrandSectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource BrandMutedBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="80" />
    </Style>

    <!--
        Direct dictionary key (not inside ThemeDictionaries) so code-behind can resolve it
        via Application.Current.Resources; nested theme-dictionary keys are not visible there.
    -->
    <Style x:Key="BrandEntryCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource BrandInkElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BrandStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource BrandCardCornerRadius}" />
        <Setter Property="Padding" Value="14,10" />
    </Style>
</ResourceDictionary>
